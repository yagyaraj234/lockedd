.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# android/ contains hand-written native code (BlockingActivity, accessibility
# service, manifest) — it is source, not generated. Ignore only build outputs.
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
/android/app/.cxx/
/android/.cxx/

# Gradle / Kotlin / Android build artifacts (app + local Expo modules)
.gradle/
**/.cxx/
**/android/build/
**/android/.gradle/
**/android/local.properties
*.apk
*.aab
*.ap_
*.aar
*.dex

# copied leftover / local-only files
/Configure
/locked.apk

# test coverage
coverage/
.nyc_output/
