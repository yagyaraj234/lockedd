<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for AppBlockingAccessibilityService. Only typeWindowStateChanged is
  needed for foreground-app detection; typeWindowContentChanged fires constantly
  and would amplify the re-launch loop. We read only event.packageName, so window
  content retrieval is not required.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagDefault"
  android:canRetrieveWindowContent="false"
  android:notificationTimeout="100"
  android:description="@string/app_name" />
